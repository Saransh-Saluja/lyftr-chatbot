# Copy to .env and fill in. NEVER commit the real .env.
# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
# LiteLLM model name. VERIFY it is live with your provider (gemini-2.0-flash was shut down).
LLM_MODEL=gemini/gemini-3.1-flash-lite
# Optional: custom OpenAI-compatible endpoint (leave empty for real Gemini).
LLM_API_BASE=
DATABASE_URL=sqlite:////data/app.db
# Browsers treat localhost and 127.0.0.1 as DIFFERENT origins; list every origin you open the UI from.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true only for demos/tests; the X-Simulate-Failure header is ignored otherwise.
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# Frontend only, read at BUILD time (baked into the JS). Must be the URL your BROWSER uses to reach the backend.
VITE_API_BASE_URL=http://localhost:8000

# --- Deployed backend (set these in the host's dashboard, NOT in a file) ---
# PORT is injected by the host (Render uses 10000); the image reads it automatically.
# ALLOWED_ORIGINS must be the exact frontend origin, e.g. https://your-app.vercel.app
# VITE_API_BASE_URL is set in the FRONTEND host (Vercel) = your backend's public https URL.
